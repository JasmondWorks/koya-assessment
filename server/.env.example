PORT=3000

# The key clients must send back in the X-API-Key header on every request.
# You choose this value — it's not issued by anything external.
API_KEY=replace-with-a-long-random-string

# Postgres connection string, e.g. from Neon. Must be reachable from
# wherever this process runs.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
